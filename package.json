{
  "name": "truthsync-action",
  "version": "0.1.0",
  "description": "Detect drift between repository facts and human-facing documentation.",
  "main": "dist/index.js",
  "bin": {
    "truthsync": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "package": "ncc build src/index.ts -o dist && ncc build src/cli.ts -o dist/cli",
    "all": "npm run format && npm run lint && npm test && npm run package"
  },
  "keywords": [
    "github-action",
    "documentation",
    "drift-detection",
    "developer-experience",
    "docs-as-code"
  ],
  "author": "jonathan-shizuka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathan-shizuka/truthsync-action.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
